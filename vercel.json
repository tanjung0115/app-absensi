{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/static/(.*)", "destination": "/frontend/$1" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/admin", "destination": "/frontend/index.html" },
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
